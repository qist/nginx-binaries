 static char *
+ngx_stream_proxy_protocol(ngx_conf_t *cf, ngx_command_t *cmd, void *conf)
+{
+    ngx_stream_proxy_srv_conf_t *pscf = conf;
+
+    ngx_str_t                            *value;
+    ngx_stream_compile_complex_value_t    ccv;
+
+    if (pscf->proxy_protocol != NGX_CONF_UNSET_UINT
+        || pscf->proxy_protocol_var != NGX_CONF_UNSET_PTR)
+    {
+        return "is duplicate";
+    }
+
+    value = cf->args->elts;
+
+    if (ngx_strcasecmp(value[1].data, (u_char *) "off") == 0) {
+        pscf->proxy_protocol = 0;
+        pscf->proxy_protocol_var = NULL;
+        return NGX_CONF_OK;
+    }
+
+    if (ngx_strcasecmp(value[1].data, (u_char *) "on") == 0
+        || ngx_strcasecmp(value[1].data, (u_char *) "v1") == 0)
+    {
+        pscf->proxy_protocol = 1;
+        pscf->proxy_protocol_var = NULL;
+        return NGX_CONF_OK;
+    }
+
+    if (ngx_strcasecmp(value[1].data, (u_char *) "v2") == 0) {
+        pscf->proxy_protocol = 2;
+        pscf->proxy_protocol_var = NULL;
+        return NGX_CONF_OK;
+    }
+
+    /*
+     * 静态值（不含变量）必须在上面的白名单里，配置阶段就报错；
+     * 否则 nginx -t 会通过，直到第一个连接才失败。
+     */
+    if (ngx_strlchr(value[1].data, value[1].data + value[1].len, '$')
+        == NULL)
+    {
+        return "invalid value";
+    }
+
+    pscf->proxy_protocol_var = ngx_pcalloc(cf->pool,
+                                           sizeof(ngx_stream_complex_value_t));
+    if (pscf->proxy_protocol_var == NULL) {
+        return NGX_CONF_ERROR;
+    }
+
+    ngx_memzero(&ccv, sizeof(ngx_stream_compile_complex_value_t));
+
+    ccv.cf = cf;
+    ccv.value = &value[1];
+    ccv.complex_value = pscf->proxy_protocol_var;
+
+    if (ngx_stream_compile_complex_value(&ccv) != NGX_OK) {
+        return NGX_CONF_ERROR;
+    }
+
+    pscf->proxy_protocol = 0;
+
+    return NGX_CONF_OK;
+}
